# Copy to deploy/.env.deploy and fill in. That file is gitignored — never commit it.
#
#   cp deploy/.env.deploy.example deploy/.env.deploy
#
# This one file feeds all three server containers in docker-compose, replacing
# the two separate real env files (backend/.env and
# backend/Rag_Chatbot/app/.env) that currently hold overlapping values. In AWS
# these same keys become SSM Parameter Store SecureString parameters that the
# ECS task definitions pull in — see DEPLOYMENT.md Phase 3.
#
# Names matter and are NOT consistent across services. Two traps:
#   * AI_interviewer reads MONGO_DB_NAME   (core/config.py:37)
#   * Rag_Chatbot   reads MONGODB_DB_NAME  (core/config.py:68)
#   Both are needed, both should hold "Prolign".
#   * Rag_Chatbot's primary key name is GROQ_API_KEYS (plural, comma-separated
#     rotation pool) and falls back to GROQ_API_KEY.


# ── Shared: MongoDB Atlas ─────────────────────────────────────────────────────
# All three services hit the same cluster and database.
# Atlas Network Access must allowlist whatever public IP the ECS container
# instance uses, or every service fails to reach the DB.
MONGO_URI=
MONGO_DB_NAME=Prolign
MONGODB_DB_NAME=Prolign


# ── Node API: required, process exits without them ───────────────────────────
# config/env.js:21-31 calls process.exit(1) if any of these is missing.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=


# ── Node API: optional ────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# Google OAuth. GOOGLE_CALLBACK_URL is set per-environment in compose / the task
# definition, not here, because it must match the public origin exactly and also
# be registered in the Google Cloud console's Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# ── Groq (all three AI paths) ─────────────────────────────────────────────────
# Single key for the Node CV parser and AI_interviewer.
GROQ_API_KEY=
# Comma-separated pool for Rag_Chatbot's key rotation (core/key_pool.py). Set it
# to the same single key if you only have one.
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile


# ── Rag_Chatbot: required, RuntimeError at import without them ────────────────
# SLACK_WEBHOOK_URL is required by core/config.py:69 but never actually read by
# any code path — only SLACK_COMPLAINT_WEBHOOK_URL is used
# (services/complaint_service.py:97). Set both anyway or the app will not import.
SLACK_WEBHOOK_URL=
SLACK_COMPLAINT_WEBHOOK_URL=

FAQ_MATCH_THRESHOLD=0.4
FAQ_MATCH_COUNT=3
MEMORY_LIMIT=6


# ── Frontend build args (compose reads these from the shell/this file) ────────
# Vite compiles these into the bundle at BUILD time. Changing them requires a
# rebuild, not a restart. The three URL vars are hardcoded to root-relative
# paths in docker-compose.yml and are deliberately not listed here.
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
