{
  "family": "prolign",
  "networkMode": "bridge",
  "requiresCompatibilities": ["EC2"],
  "cpu": "2048",
  "memory": "3584",
  "executionRoleArn": "arn:aws:iam::069519367008:role/prolignTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "edge",
      "image": "069519367008.dkr.ecr.ap-south-1.amazonaws.com/prolign/edge:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 80, "hostPort": 80, "protocol": "tcp" }],
      "links": ["backend", "ai-interviewer", "rag-chatbot"],
      "cpu": 128,
      "memoryReservation": 128,
      "memory": 256,
      "dependsOn": [
        { "containerName": "backend", "condition": "START" },
        { "containerName": "ai-interviewer", "condition": "START" },
        { "containerName": "rag-chatbot", "condition": "START" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/prolign/edge",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "edge",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "backend",
      "image": "069519367008.dkr.ecr.ap-south-1.amazonaws.com/prolign/backend:latest",
      "essential": true,
      "cpu": 512,
      "memoryReservation": 384,
      "memory": 640,
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "5000" },
        { "name": "FRONTEND_URL", "value": "https://prolign.vercel.app" },
        { "name": "GOOGLE_CALLBACK_URL", "value": "https://dni5ezjm23i3q.cloudfront.net/api/auth/google/callback" },
        { "name": "OTP_EXPIRY_MINUTES", "value": "10" },
        { "name": "OTP_MAX_ATTEMPTS", "value": "3" }
      ],
      "secrets": [
        { "name": "MONGO_URI", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/MONGO_URI" },
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/JWT_SECRET" },
        { "name": "JWT_REFRESH_SECRET", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/JWT_REFRESH_SECRET" },
        { "name": "JWT_EXPIRES_IN", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/JWT_EXPIRES_IN" },
        { "name": "JWT_REFRESH_EXPIRES_IN", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/JWT_REFRESH_EXPIRES_IN" },
        { "name": "EMAIL_HOST", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/EMAIL_HOST" },
        { "name": "EMAIL_PORT", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/EMAIL_PORT" },
        { "name": "EMAIL_USER", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/EMAIL_USER" },
        { "name": "EMAIL_PASS", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/EMAIL_PASS" },
        { "name": "EMAIL_FROM", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/EMAIL_FROM" },
        { "name": "GOOGLE_CLIENT_ID", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/GOOGLE_CLIENT_ID" },
        { "name": "GOOGLE_CLIENT_SECRET", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/GOOGLE_CLIENT_SECRET" },
        { "name": "STRIPE_SECRET_KEY", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/STRIPE_SECRET_KEY" },
        { "name": "STRIPE_WEBHOOK_SECRET", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/STRIPE_WEBHOOK_SECRET" },
        { "name": "GROQ_API_KEY", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/GROQ_API_KEY" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/prolign/backend",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "backend",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "ai-interviewer",
      "image": "069519367008.dkr.ecr.ap-south-1.amazonaws.com/prolign/ai-interviewer:latest",
      "essential": true,
      "cpu": 384,
      "memoryReservation": 256,
      "memory": 512,
      "secrets": [
        { "name": "MONGO_URI", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/MONGO_URI" },
        { "name": "MONGO_DB_NAME", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/MONGO_DB_NAME" },
        { "name": "GROQ_API_KEY", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/GROQ_API_KEY" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/prolign/ai-interviewer",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ai-interviewer",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "rag-chatbot",
      "image": "069519367008.dkr.ecr.ap-south-1.amazonaws.com/prolign/rag-chatbot:latest",
      "essential": true,
      "cpu": 1024,
      "memoryReservation": 768,
      "memory": 1280,
      "environment": [
        { "name": "FRONTEND_ORIGIN", "value": "https://prolign.vercel.app" }
      ],
      "secrets": [
        { "name": "MONGO_URI", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/MONGO_URI" },
        { "name": "MONGODB_DB_NAME", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/MONGODB_DB_NAME" },
        { "name": "GROQ_API_KEY", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/GROQ_API_KEY" },
        { "name": "SLACK_WEBHOOK_URL", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/SLACK_WEBHOOK_URL" },
        { "name": "SLACK_COMPLAINT_WEBHOOK_URL", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/SLACK_COMPLAINT_WEBHOOK_URL" },
        { "name": "GROQ_MODEL", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/GROQ_MODEL" },
        { "name": "FAQ_MATCH_THRESHOLD", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/FAQ_MATCH_THRESHOLD" },
        { "name": "FAQ_MATCH_COUNT", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/FAQ_MATCH_COUNT" },
        { "name": "MEMORY_LIMIT", "valueFrom": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/MEMORY_LIMIT" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/prolign/rag-chatbot",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "rag-chatbot",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
