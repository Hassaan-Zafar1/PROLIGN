{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadProlignSecrets",
      "Effect": "Allow",
      "Action": ["ssm:GetParameters"],
      "Resource": "arn:aws:ssm:ap-south-1:069519367008:parameter/prolign/prod/*"
    },
    {
      "Sid": "DecryptProlignSecrets",
      "Effect": "Allow",
      "Action": ["kms:Decrypt"],
      "Resource": "arn:aws:kms:ap-south-1:069519367008:alias/aws/ssm"
    }
  ]
}
